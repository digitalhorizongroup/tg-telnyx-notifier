# Артефакты окружения и кэши — не нужны в контексте сборки.
.venv
.git
.claude
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
dist
build
**/*.egg-info

# Наборы тестов в образ не идут: сборка ставит пакет без dev-группы, и pytest
# в рантайме отсутствует.
tests

# Секреты мимо контекста сборки: значения приходят переменными окружения.
.env
.env.*
