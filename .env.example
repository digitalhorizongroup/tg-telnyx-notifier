# Образец окружения: скопировать в `.env` и подставить свои значения.
# Сам `.env` под .gitignore — реальные значения в репозиторий не попадают.

# Токен бота от BotFather. Он же даёт доступ к отправке от имени бота, поэтому
# живёт только здесь и в окружении контейнера.
TGTN_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Канал, куда уходят сообщения: числовой идентификатор, не `@имя`. У канала имя
# может смениться, идентификатор — нет. У каналов и супергрупп он отрицательный
# и начинается с `-100`. Бот должен быть в канале администратором с правом
# публикации, иначе Telegram отвечает 403.
TGTN_CHAT_ID=-1000000000000

# Кому кроме канала отвечает команда `/activity` — идентификаторы через запятую.
# Пусто: команда работает только в самом канале.
TGTN_ADMIN_IDS=

# Внешний адрес сервиса без завершающего слэша. По нему Telegram доставляет
# апдейты на `/telegram/updates`; тот же домен настроен в профиле Telnyx.
# Не задан — webhook не регистрируется и команда активности недоступна,
# пересылка сообщений при этом работает.
TGTN_PUBLIC_URL=https://example.com

# Общий секрет с Telegram: уходит в setWebhook и приезжает обратно заголовком
# X-Telegram-Bot-Api-Secret-Token. Маршрут апдейтов открыт наружу, и это
# единственное, что отличает Telegram от постороннего. Своё значение:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
TGTN_TELEGRAM_WEBHOOK_SECRET=замените-на-случайную-строку

# Каталог рантайм-данных: там лежит база очереди. В контейнере — точка
# монтирования тома, иначе очередь пропадёт вместе с контейнером.
TGTN_DATA_DIR=.project

# Сколько суток разобранные сообщения лежат в базе. Очередь чистка не трогает.
TGTN_HISTORY_DAYS=30

# Пауза между отправками: базовая и потолок, в секундах. Под непрерывным
# наплывом пауза удваивается от базовой до потолка, на спокойной очереди
# возвращается к базовой.
TGTN_SEND_BASE_DELAY=5
TGTN_SEND_MAX_DELAY=30

# Куда привязывается HTTP-сервер. `0.0.0.0` — в контейнере свой адрес заранее
# неизвестен; наружу порт публикует `docker run -p`.
TGTN_HOST=0.0.0.0
TGTN_PORT=8000

# Пороги журнала. Первый — для своего дерева логгеров, второй — для сторонних
# библиотек. Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL.
TGTN_APP_LOG_LEVEL=DEBUG
TGTN_LIB_LOG_LEVEL=INFO
